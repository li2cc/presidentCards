# Copy to .streamlit/secrets.toml (git-ignored) or paste into Community Cloud > Settings > Secrets.
# Use the Supabase *Session pooler* URI (Project > Connect > Session pooler), NOT db.<ref>.supabase.co (IPv6 only).
DATABASE_URL = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional: protects the Build Database and Admin pages.
ADMIN_PASSWORD = "change-me"
